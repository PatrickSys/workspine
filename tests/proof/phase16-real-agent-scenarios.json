    {
      "id": "csv-quality-gate-greenfield",
      "oracle_id": "csv-quality-boundary",
      "title": "Headless greenfield CSV quality gate",
      "source": { "kind": "generated", "name": "empty-git-root", "immutable": true },
      "public_task": "Build src/csv_quality.py using only the Python standard library. It must normalize a valid two-column CSV to name,email with trimmed cells, reject malformed rows with a nonzero exit, refuse input/output aliases, and never leave an accepted partial output after failure.",
      "public_symptom": "A headless greenfield run needs a clear import-quality boundary before the first implementation change.",
      "flow": ["setup", "health", "new-project", "plan", "execute", "verify"],
      "required_artifact_family": "project-plan-summary-verification",
      "greenfield_input": {
        "brief_path": ".work/PROJECT_BRIEF.md",
        "brief_source_path": "PROJECT_BRIEF.md",
        "brief_route": "documented work-new-project auto route",
        "brief_content": "Build a standard-library CSV quality gate. Accept valid rows, reject malformed rows, and refuse input/output aliases without writing an accepted result.",
        "task_inputs": [
          { "path": "input.csv", "content": " name , email\nAda , ada@example.test\nGrace,grace@example.test\n" },
          { "path": "invalid.csv", "content": "name,email\nAda\n" }
        ],
        "forbidden_seed_paths": ["SPEC.md", "ROADMAP.md", "PLAN.md", "SUMMARY.md", "VERIFICATION.md"]
      },
      "setup_commands": [["git", "init"], ["workspine", "init", "--auto", "--tools", "$RUNTIME", "--brief", "PROJECT_BRIEF.md"], ["workspine", "setup", "--yes"]],
      "public_checks": [
        { "id": "valid_csv", "argv": ["python", "src/csv_quality.py", "input.csv", "output.csv"] },
        { "id": "invalid_csv", "argv": ["python", "src/csv_quality.py", "invalid.csv", "rejected.csv"] }
      ],
      "behavior_ids": ["csv_valid_result", "csv_malformed_rejection", "csv_alias_refusal"],
      "hidden_checks": [
        { "id": "accepted_output", "kind": "byte_exact_valid_result" },
        { "id": "rejected_input", "kind": "nonzero_without_accepted_output" },
        { "id": "alias_safety", "kind": "input_output_alias_refusal" }
      ],
      "allowed_change_paths": ["src/csv_quality.py", "tests/"],
      "preserve_paths": [".work/PROJECT_BRIEF.md", "input.csv", "invalid.csv"],
      "role_budgets_seconds": { "plan_check": 900, "execute": 1500, "independent_verify": 900 },
      "timeout_seconds": 3300,
      "claim_limit": "Only this bounded standard-library CSV task through the documented headless init --auto route; this is not the standard interactive setup journey and supports no general Python or quality claim."
    },
